# Copy this file to .env for local backend execution. Do not commit .env.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=25

# Vector and embedding stack for new indexes. Changing the embedding model requires re-indexing.
VECTOR_BACKEND=qdrant
TEXT_EMBEDDING_MODEL=BAAI/bge-m3
TEXT_EMBEDDING_DIM=1024
CLIP_MODEL=sentence-transformers/clip-ViT-B-32
EMBEDDING_BATCH_SIZE=8

# Chunk overlap (word-based; pages are never merged)
CHUNK_TARGET_WORDS=420
CHUNK_OVERLAP_WORDS=60

# Document parsing. auto uses MinerU if mineru-kit exists; otherwise PyMuPDF + EasyOCR fallback.
DOCUMENT_PARSER=auto
MINERU_TIER=standard
MINERU_TIMEOUT_SECONDS=900
OCR_TRIGGER_CHARS=35
OCR_MIN_CONFIDENCE=0.20
# auto OCRs up to three embedded-image crops/page when MinerU is unavailable.
OCR_FIGURE_CROPS=auto
MAX_FIGURE_CROPS_OCR_PER_PAGE=3

# Additional learned reranking uses more memory; enable only after baseline works.
ENABLE_CROSS_ENCODER=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Local Ollama: host-run development uses 127.0.0.1; Docker Compose overrides this to host.docker.internal.
OLLAMA_URL=http://127.0.0.1:11434
VISION_MODEL=qwen2.5vl:3b
ENABLE_TEXT_GENERATION=true
VISION_TIMEOUT=300
